#!/usr/bin/env bash
# ScanORC GUI Entry Wrapper
set -e

SCANORC_DIR="/opt/scanorc"

find_python() {
    # 優先使用系統 PyQt6 (確保 Linux 桌面原生 fcitx5 中文輸入法相容性)
    if /usr/bin/python3 -c "import PyQt6" 2>/dev/null; then
        echo "/usr/bin/python3"
    elif python3 -c "import PyQt6" 2>/dev/null; then
        echo "python3"
    elif [ -f "$SCANORC_DIR/.venv/bin/python" ]; then
        echo "$SCANORC_DIR/.venv/bin/python"
    elif [ -f "$HOME/.local/share/scanorc/venv/bin/python" ]; then
        echo "$HOME/.local/share/scanorc/venv/bin/python"
    elif [ -n "$VIRTUAL_ENV" ] && [ -f "$VIRTUAL_ENV/bin/python" ]; then
        echo "$VIRTUAL_ENV/bin/python"
    elif [ -n "$CONDA_PREFIX" ] && [ -f "$CONDA_PREFIX/bin/python" ]; then
        echo "$CONDA_PREFIX/bin/python"
    elif [ -x "/opt/anaconda3/bin/python" ]; then
        echo "/opt/anaconda3/bin/python"
    elif [ -x "$HOME/anaconda3/bin/python" ]; then
        echo "$HOME/anaconda3/bin/python"
    elif python3 -c "import PySide6" 2>/dev/null; then
        echo "python3"
    elif /usr/bin/python3 -c "import PySide6" 2>/dev/null; then
        echo "/usr/bin/python3"
    else
        echo ""
    fi
}

PY_BIN="$(find_python)"

if [ -z "$PY_BIN" ]; then
    MSG="[ScanORC] 尚未偵測到 Python 執行環境！\n請先於終端機執行: sudo scanorc-setup (或 scanorc-setup --user)"
    if [ -n "$DISPLAY" ] && command -v zenity >/dev/null 2>&1; then
        zenity --error --title="ScanORC 缺少執行環境" --text="$MSG"
    elif [ -n "$DISPLAY" ] && command -v kdialog >/dev/null 2>&1; then
        kdialog --error "$MSG"
    else
        echo -e "$MSG" >&2
    fi
    exit 1
fi

exec "$PY_BIN" "$SCANORC_DIR/app_gui.py" "$@"
