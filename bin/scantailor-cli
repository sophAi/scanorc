#!/usr/bin/env bash
# ==============================================================================
# ScanTailor-CLI Standalone Wrapper for ScanORC (方案 A - 作法 1)
# 自動設定專案內部動態庫目錄 (bin/lib) 與 Qt 圖像格式外掛 (bin/plugins)
# 免去系統全域安裝 Qt4 與 ScanTailor 的依賴，實現 100% 免安裝可攜式執行
# ==============================================================================
set -e

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LD_LIBRARY_PATH="$SELF_DIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$SELF_DIR/plugins"

exec "$SELF_DIR/scantailor-cli-bin" "$@"
